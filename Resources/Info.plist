<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dock2.app — the bundle dock2 runs from.

  `LSUIElement`: no Dock icon and no menu bar. dock2 is the Dock; the platter's right-click menu is
  how to quit it.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>dock2</string>
	<key>CFBundleDisplayName</key>
	<string>dock2</string>
	<key>CFBundleExecutable</key>
	<string>dock2</string>
	<key>CFBundleIdentifier</key>
	<string>zip.tanner.dock2</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Placeholders. `make app` stamps both from git: the version from the tag, the build from the
	     commit count. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
