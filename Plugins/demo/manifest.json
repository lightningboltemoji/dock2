{
  "id": "zip.tanner.dock2.demo",
  "name": "Demo",
  "description": "Every view dock2 draws, in every variation, over made-up data. Loaded by debug runs only.",
  "author": "Dock2",
  "icon": {"symbol": "square.grid.2x2"},
  "tint": "purple",
  "version": "1.0.0",
  "api": 1,
  "module": "plugin.wasm",
  "capabilities": {
    "clipboard.write": {"reason": "Copies from its example rows, to show what a copy looks like."}
  },
  "commands": [
    {"id": "gallery", "title": "Demo Gallery", "subtitle": "Every view, every variation", "icon": {"symbol": "square.grid.2x2"}, "keywords": ["views", "screens"], "view": true},
    {"id": "list", "title": "Demo List", "subtitle": "Every row a list can draw", "icon": {"symbol": "list.bullet"}, "view": true},
    {"id": "detail", "title": "Demo Detail", "subtitle": "Every combination of a detail", "icon": {"symbol": "doc.richtext"}, "view": true},
    {"id": "form", "title": "Demo Form", "subtitle": "Every kind of field", "icon": {"symbol": "rectangle.and.pencil.and.ellipsis"}, "view": true},
    {"id": "grid", "title": "Demo Grid", "subtitle": "Every kind of picture", "icon": {"symbol": "square.grid.3x3"}, "view": true},
    {"id": "feedback", "title": "Demo Feedback", "subtitle": "Toasts, confirmations, navigation", "icon": {"symbol": "bubble.left"}, "view": true},
    {"id": "maximal", "title": "Demo Maximal", "subtitle": "Every view, filled past what it was built for", "icon": {"symbol": "rectangle.compress.vertical"}, "view": true}
  ]
}
